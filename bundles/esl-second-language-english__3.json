A1ndares%20y%20Expectativas%20Programa%20de%20Ingl%C3%A9s.pdf"}],[0,"3.W.5.1a","","indicator","Writing",{"withheld":1,"src":"https://dedigital.dde.pr/pluginfile.php/145102/mod_resource/content/6/Est%C3%A1ndares%20y%20Expectativas%20Programa%20de%20Ingl%C3%A9s.pdf"}],[0,"3.W.5.1b","","indicator","Writing",{"withheld":1,"src":"https://dedigital.dde.pr/pluginfile.php/145102/mod_resource/content/6/Est%C3%A1ndares%20y%20Expectativas%20Programa%20de%20Ingl%C3%A9s.pdf"}],[0,"3.W.6","","standard","Writing",{"withheld":1,"src":"https://dedigital.dde.pr/pluginfile.php/145102/mod_resource/content/6/Est%C3%A1ndares%20y%20Expectativas%20Programa%20de%20Ingl%C3%A9s.pdf"}],[0,"3.W.6.1","","expectation","Writing",{"withheld":1,"src":"https://dedigital.dde.pr/pluginfile.php/145102/mod_resource/content/6/Est%C3%A1ndares%20y%20Expectativas%20Programa%20de%20Ingl%C3%A9s.pdf"}],[0,"3.W.7","","standard","Writing",{"withheld":1,"src":"https://dedigital.dde.pr/pluginfile.php/145102/mod_resource/content/6/Est%C3%A1ndares%20y%20Expectativas%20Programa%20de%20Ingl%C3%A9s.pdf"}],[0,"3.W.7.1","","expectation","Writing",{"withheld":1,"src":"https://dedigital.dde.pr/pluginfile.php/145102/mod_resource/content/6/Est%C3%A1ndares%20y%20Expectativas%20Programa%20de%20Ingl%C3%A9s.pdf"}],[0,"3.W.8","","standard","Writing",{"withheld":1,"src":"https://dedigital.dde.pr/pluginfile.php/145102/mod_resource/content/6/Est%C3%A1ndares%20y%20Expectativas%20Programa%20de%20Ingl%C3%A9s.pdf"}],[0,"3.W.8.1","","expectation","Writing",{"withheld":1,"src":"https://dedigital.dde.pr/pluginfile.php/145102/mod_resource/content/6/Est%C3%A1ndares%20y%20Expectativas%20Programa%20de%20Ingl%C3%A9s.pdf"}],[0,"3.W.8.1a","","indicator","Writing",{"withheld":1,"src":"https://dedigital.dde.pr/pluginfile.php/145102/mod_resource/content/6/Est%C3%A1ndares%20y%20Expectativas%20Programa%20de%20Ingl%C3%A9s.pdf"}],[1,"128.5(b)(1)(A)","listen actively, ask relevant questions to clarify information, and make pertinent comments;","expectation","1",null],[1,"128.5(b)(1)(B)","follow, restate, and give oral instructions that involve a series of related sequences of action;","expectation","1",null],[1,"128.5(b)(1)(C)","speak coherently about the topic under discussion, employing eye contact, speaking rate, volume, enunciation, and the conventions of language to communicate ideas effectively;","expectation","1",null],[1,"128.5(b)(1)(D)","work collaboratively with others by following agreed-upon rules, norms, and protocols; and","expectation","1",null],[1,"128.5(b)(1)(E)","develop social communication such as conversing politely in all situations.","expectation","1",null],[1,"128.5(b)(2)(A)","demonstrate and apply phonetic knowledge by: (i) decoding words with a prosodic or orthographic accent; (ii) decoding words with multiple sound spelling patterns such as c, k, and q and s, z, soft c, and x; (iii) decoding words with silent h and words that use the syllables que-, qui-, gue-, gui-, güe-, and güi-; (iv) becoming very familiar with the concept of hiatus and diphthongs and the implications for orthographic accents; (v) decoding and differentiating meaning of a word based on a diacritical accent; and (vi) decoding words with prefixes and suffixes;","expectation","2",null],[1,"128.5(b)(2)(B)","demonstrate and apply spelling knowledge by: (i) spelling palabras agudas and graves (words with an accent on the last and penultimate syllable); (ii) spelling palabras esdrújulas (words with the stress on the antepenultimate syllable) that have an orthographic accent; (iii) spelling words with the concept of diphthongs and hiatus and their implications for orthographic accents; (iv) using accents on words commonly used in questions and exclamations; (v) spelling words based on the diacritical accent such as se/sé, el/él, and mas/más; (vi) marking accents appropriately when conjugating verbs such as in simple and imperfect past, past participle, perfect, conditional, and future tenses; (vii) spelling words with silent h and words that use the syllables que-, qui-, gue-, gui-, güe-, and güi-; (viii) spelling words that have the same sounds represented by different letters, including ll and y; c, k, and q; soft c, soft x, s, and z; and soft g, j, and x; (ix) spelling words with hard and soft r; (x) spelling words using n before v; m before b; and m before p; (xi) spelling words with sílabas trabadas; and (xii) spelling the plural form of words ending in z by replacing the z with c before adding -es;","expectation","2",null],[1,"128.5(b)(2)(C)","alphabetize a series of words to the third letter; and","expectation","2",null],[1,"128.5(b)(2)(D)","write complete words, thoughts, and answers legibly in cursive leaving appropriate spaces between words.","expectation","2",null],[1,"128.5(b)(3)(A)","use print or digital resources to determine meaning, syllabication, and pronunciation;","expectation","3",null],[1,"128.5(b)(3)(B)","use context within and beyond a sentence to determine the meaning of unfamiliar words and multiple-meaning words;","expectation","3",null],[1,"128.5(b)(3)(C)","identify the meaning of and use words with affixes such as in-, des-, ex-, -mente, -dad, - oso, -eza, and -ura, and know how the affix changes the meaning of the word;","expectation","3",null],[1,"128.5(b)(3)(D)","identify, use, and explain the meaning of antonyms, synonyms, idioms, homophones, and homographs in a text; and","expectation","3",null],[1,"128.5(b)(3)(E)","differentiate between and use homographs, homophones, and commonly confused terms such as porque/porqué/por qué/por que, sino/si no, and también/tan bien.","expectation","3",null],[1,"128.5(b)(4)","Developing and sustaining foundational language skills: listening, speaking, reading, writing, and thinking--fluency. The student reads grade-level text with fluency and comprehension. The student is expected to use appropriate fluency (rate, accuracy, and prosody) when reading grade-level text.","strand","4",null],[1,"128.5(b)(5)","Developing and sustaining foundational language skills: listening, speaking, reading, writing, and thinking--self-sustained reading. The student reads grade-appropriate texts independently. The student is expected to self-select text and read independently for a sustained period of time.","strand","5",null],[1,"128.5(b)(6)(A)","establish purpose for reading assigned and self-selected texts;","expectation","6",null],[1,"128.5(b)(6)(B)","generate questions about text before, during, and after reading to deepen understanding and gain information;","expectation","6",null],[1,"128.5(b)(6)(C)","make and correct or confirm predictions using text features, characteristics of genre, and structures;","expectation","6",null],[1,"128.5(b)(6)(D)","create mental images to deepen understanding;","expectation","6",null],[1,"128.5(b)(6)(E)","make connections to personal experiences, ideas in other texts, and society;","expectation","6",null],[1,"128.5(b)(6)(F)","make inferences and use evidence to support understanding;","expectation","6",null],[1,"128.5(b)(6)(G)","evaluate details read to determine key ideas;","expectation","6",null],[1,"128.5(b)(6)(H)","synthesize information to create new understanding; and","expectation","6",null],[1,"128.5(b)(6)(I)","monitor comprehension and make adjustments such as re-reading, using background knowledge, asking questions, and annotating when understanding breaks down.","expectation","6",null],[1,"128.5(b)(7)(A)","describe personal connections to a variety of sources, including self-selected texts;","expectation","7",null],[1,"128.5(b)(7)(B)","write a response to a literary or informational text that demonstrates an understanding of a text;","expectation","7",null],[1,"128.5(b)(7)(C)","use text evidence to support an appropriate response;","expectation","7",null],[1,"128.5(b)(7)(D)","retell and paraphrase texts in ways that maintain meaning and logical order;","expectation","7",null],[1,"128.5(b)(7)(E)","interact with sources in meaningful ways such as notetaking, annotating, freewriting, or illustrating;","expectation","7",null],[1,"128.5(b)(7)(F)","respond using newly acquired vocabulary as appropriate; and","expectation","7",null],[1,"128.5(b)(7)(G)","discuss specific ideas in the text that are important to the meaning.","expectation","7",null],[1,"128.5(b)(8)(A)","infer the theme of a work, distinguishing theme from topic;","expectation","8",null],[1,"128.5(b)(8)(B)","explain the relationships among the major and minor characters;","expectation","8",null],[1,"128.5(b)(8)(C)","analyze plot elements, including the sequence of events, the conflict, and the resolution; and","expectation","8",null],[1,"128.5(b)(8)(D)","explain the influence of the setting on the plot.","expectation","8",null],[1,"128.5(b)(9)(A)","demonstrate knowledge of distinguishing characteristics of well-known children's literature such as folktales, fables, fairy tales, legends, and myths;","expectation","9",null],[1,"128.5(b)(9)(B)","explain rhyme scheme, sound devices, and structural elements such as stanzas in a variety of poems;","expectation","9",null],[1,"128.5(b)(9)(C)","discuss elements of drama such as characters, dialogue, setting, and acts;","expectation","9",null],[1,"128.5(b)(9)(D)","recognize characteristics and structures of informational text, including: (i) the central idea with supporting evidence; (ii) features such as sections, tables, graphs, timelines, bullets, numbers, and bold and italicized font to support understanding; and (iii) organizational patterns such as cause and effect and problem and solution;","expectation","9",null],[1,"128.5(b)(9)(E)","recognize characteristics and structures of argumentative text by: (i) identifying the claim; (ii) distinguishing facts from opinion; and (iii) identifying the intended audience or reader; and","expectation","9",null],[1,"128.5(b)(9)(F)","recognize characteristics of multimodal and digital texts.","expectation","9",null],[1,"128.5(b)(10)(A)","explain the author's purpose and message within a text;","expectation","10",null],[1,"128.5(b)(10)(B)","explain how the use of text structure contributes to the author's purpose;","expectation","10",null],[1,"128.5(b)(10)(C)","explain the author's use of print and graphic features to achieve specific purposes;","expectation","10",null],[1,"128.5(b)(10)(D)","describe how the author's use of imagery, literal and figurative language such as simile, and sound devices such as onomatopoeia achieves specific purposes;","expectation","10",null],[1,"128.5(b)(10)(E)","identify the use of literary devices, including first- or third-person point of view;","expectation","10",null],[1,"128.5(b)(10)(F)","discuss how the author's use of language contributes to voice; and","expectation","10",null],[1,"128.5(b)(10)(G)","identify and explain the use of hyperbole.","expectation","10",null],[1,"128.5(b)(11)(A)","plan a first draft by selecting a genre for a particular topic, purpose, and audience using a range of strategies such as brainstorming, freewriting, and mapping;","expectation","11",null],[1,"128.5(b)(11)(B)","develop drafts into a focused, structured, and coherent piece of writing by: (i) organizing with purposeful structure, including an introduction and a conclusion; and (ii) developing an engaging idea with relevant details;","expectation","11",null],[1,"128.5(b)(11)(C)","revise drafts to improve sentence structure and word choice by adding, deleting, combining, and rearranging ideas for coherence and clarity;","expectation","11",null],[1,"128.5(b)(11)(D)","edit drafts using standard Spanish conventions, including: (i) complete simple and compound sentences with subject-verb agreement; (ii) verb tense such as simple past, present, and future and imperfect past, past participle, perfect, and conditional, including the difference between ser and estar; (iii) singular, plural, common, and proper nouns, including gender-specific articles; (iv) adjectives, including their comparative and superlative forms; (v) adverbs that convey time and adverbs that convey manner; (vi) prepositions and prepositional phrases; (vii) pronouns, including personal, possessive, objective, and reflexive pronouns; (viii) coordinating conjunctions to form compound subjects, predicates, and sentences; (ix) capitalization of proper nouns, geographical names and places, historical periods, and official titles of people; (x) punctuation marks, including commas in a series and dates that include the day of the week, and correct mechanics, including indentations; and (xi) correct spelling of words with grade-appropriate orthographic patterns and rules; and","expectation","11",null],[1,"128.5(b)(11)(E)","publish written work for appropriate audiences.","expectation","11",null],[1,"128.5(b)(12)(A)","compose literary texts, including personal narratives and poetry, using genre characteristics and craft;","expectation","12",null],[1,"128.5(b)(12)(B)","compose informational texts, including brief compositions that convey information about a topic, using a clear central idea and genre characteristics and craft;","expectation","12",null],[1,"128.5(b)(12)(C)","compose argumentative texts, including opinion essays, using genre characteristics and craft; and","expectation","12",null],[1,"128.5(b)(12)(D)","compose correspondence such as thank you notes or letters.","expectation","12",null],[1,"128.5(b)(13)(A)","generate questions on a topic for formal and informal inquiry;","expectation","13",null],[1,"128.5(b)(13)(B)","develop and follow a research plan with adult assistance;","expectation","13",null],[1,"128.5(b)(13)(C)","identify and gather relevant information from a variety of sources;","expectation","13",null],[1,"128.5(b)(13)(D)","identify primary and secondary sources;","expectation","13",null],[1,"128.5(b)(13)(E)","demonstrate understanding of information gathered;","expectation","13",null],[1,"128.5(b)(13)(F)","recognize the difference between paraphrasing and plagiarism when using source materials;","expectation","13",null],[1,"128.5(b)(13)(G)","create a works cited page; and","expectation","13",null],[1,"128.5(b)(13)(H)","use an appropriate mode of delivery, whether written, oral, or multimodal, to present results.","expectation","13",null]]}